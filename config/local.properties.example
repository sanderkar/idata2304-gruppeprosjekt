# Copy this file to config/local.properties once and replace the placeholder values.
# All applications read the local file. Environment variables override its values.
# Tokens must use 1-128 letters, digits, dots, underscores or hyphens.
# This is only used an example, and the application does not actually run any of this code.
# It is mostly there just to help with setup.

SMART_HOME_HOST=127.0.0.1
SMART_HOME_PORT=5000
# Server only. Use the password chosen when creating the keystore.
SMART_HOME_TLS_KEYSTORE_PASSWORD=replace-with-keystore-password
# Optional path overrides. Paths are relative to the project root.
# SMART_HOME_TLS_KEYSTORE=config/tls/server.p12
# SMART_HOME_TLS_CERTIFICATE=config/tls/server.crt
SMART_HOME_NODE_12_TOKEN=replace-with-node-token
# Optional. Set matching tokens on the server and the corresponding automatic nodes.
# SMART_HOME_AUTO_NODE_KITCHEN_TOKEN=replace-with-kitchen-token
# SMART_HOME_AUTO_NODE_GARAGE_TOKEN=replace-with-garage-token
# Optional server-only override for the persistent address registry.
# SMART_HOME_NODE_ADDRESS_FILE=config/state/node-addresses.properties
SMART_HOME_PANEL_TOKEN=replace-with-owner-token
SMART_HOME_SHA_TOKEN=replace-with-sha-token
SMART_HOME_GUEST_TOKEN=replace-with-guest-token
SMART_HOME_TECHNICIAN_TOKEN=replace-with-technician-token
